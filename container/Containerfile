# mpd-virt-container-apple — the Apple-container base image mpd-virt adopts as an mpd box.
# A Debian Trixie box that boots systemd as PID 1 under plain `container run`.
# Needs `--cap-add ALL` (systemd needs SYS_ADMIN to mount cgroups; without it
# it exits silently). Hostname comes from --name. Build it once with
# `container build -t mpd-virt-container-apple .`; `mpd-virt create --backend=container` (and
# a manual adopt) run and provision boxes from it.
#
# NOT libnss-resolve here: on a prepped VM prep converts eth0 to networkd, so
# systemd-resolved learns a default upstream from DHCP and nss `resolve` can
# route everything. In this container eth0 is runtime-managed, so resolved
# only knows mpd.test (10.163.141.1) and no default upstream — pointing nss at
# it via `resolve [!UNAVAIL=return]` then strands github.com and every other
# name. So nss stays `files dns` (the runtime's /etc/resolv.conf), and the
# mpd.test zone is reached the way it always is: over the wire, or `resolvectl`.
#
# The image is generic: the dev user + passwordless sudo + authorized key are
# provisioned AFTER start with `container exec` (see README), so one image
# serves every box and keys can be rotated without a rebuild.
#
# libpam-systemd + dbus-user-session are NOT decoration: a real Debian gets
# them via systemd's Recommends, but --no-install-recommends drops them, and
# without pam_systemd the per-user manager (user@<uid>) never gets a session or
# XDG_RUNTIME_DIR and fails — so mpd's user services (the portal `mpd --web`,
# `mpd --control`) never start and the box's root URL 502s. Installing them
# makes this image behave like the stock-Debian VMs adopt targets are. (The
# base is non-slim debian:trixie, matching mpd's "basic Trixie install"
# contract — an OCI base ships no systemd regardless, so the session stack is
# still installed explicitly below.)
#
#   container build -t mpd-virt-container-apple container
#   container run -d --name mpd-128 --cap-add ALL mpd-virt-container-apple
#   container exec mpd-128 systemctl is-system-running   # running/degraded = systemd up
FROM debian:trixie

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv systemd-resolved libpam-systemd \
        dbus dbus-user-session \
        openssh-server sudo wget git ca-certificates iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl enable ssh systemd-resolved \
    && systemctl mask systemd-modules-load.service

# sshd: key-only, a systemd unit now. Host keys are generated by the unit on
# first start. The dev user + key are added after boot via `container exec`.
RUN set -eux; \
    mkdir -p /run/sshd; \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'UseDNS no' \
      > /etc/ssh/sshd_config.d/10-hardening.conf

# systemd as PID 1. SIGRTMIN+3 is systemd's clean-shutdown signal.
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]

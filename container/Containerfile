# mpd-virt-container-apple — the Apple-container base image mpd-virt adopts as an mpd VM.
# Debian Trixie with systemd as PID 1 under plain `container run` (needs
# `--cap-add ALL`; hostname comes from --name).

FROM debian:trixie

# TODO(release): pin to a reviewed commit before the first public release
# (see bootstrapRef in go/internal/cli/adopt.go). Tracks main during
# development; rebuild the image when 20-install-software.sh changes upstream.
ARG MPD_BOOTSTRAP_REF=main

ARG VERSION
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.source="https://github.com/mutms/mpd-virt"

RUN apt-get update \
    && apt-get install -y --no-install-recommends sudo wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# mpd's package list (the slow layer; keep it separate).
RUN wget -qO- "https://raw.githubusercontent.com/mutms/mpd/${MPD_BOOTSTRAP_REF}/bootstrap/20-install-software.sh" | bash \
    && rm -rf /var/lib/apt/lists/*

# What an OCI base lacks and a real Debian VM has from the installer:
# systemd as PID 1, the user-session stack, sshd.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd-sysv systemd-resolved libpam-systemd dbus dbus-user-session \
        openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl enable ssh systemd-resolved \
    && systemctl mask systemd-modules-load.service \
    # A host key is a secret and identifies one VM, so the image ships
    # none: installing openssh-server generates a set, which would
    # otherwise be the same key in every VM built from this tag — the key
    # adopt pins as that VM's identity. The drop-in below makes each VM
    # its own on first boot.
    && rm -f /etc/ssh/ssh_host_*

# sshd: key-only, and its own host key on first boot. The empty
# ExecStartPre clears the unit's own list: its `sshd -t` runs before any
# appended entry and fails outright when there is no host key yet, so the
# keygen has to be put in front of it. `ssh-keygen -A` writes only what is
# missing, so later boots are a no-op.
RUN set -eux; \
    mkdir -p /run/sshd /etc/systemd/system/ssh.service.d; \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'UseDNS no' \
      > /etc/ssh/sshd_config.d/10-hardening.conf; \
    printf '%s\n' \
      '[Service]' \
      'ExecStartPre=' \
      'ExecStartPre=/usr/bin/ssh-keygen -A' \
      'ExecStartPre=/usr/sbin/sshd -t' \
      > /etc/systemd/system/ssh.service.d/10-hostkeys.conf

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]

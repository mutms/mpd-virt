# mpd-virt-container-apple — the Apple-container base image mpd-virt adopts as an mpd box.
# A Debian Trixie box that boots systemd as PID 1 under plain `container run`.
# Needs `--cap-add ALL` (systemd needs SYS_ADMIN to mount cgroups; without it
# it exits silently). Hostname comes from --name. Build it once with
# `container build -t mpd-virt-container-apple .`; `mpd-virt create --backend=container` (and
# a manual adopt) run and provision boxes from it.
#
# DNS goes through systemd-resolved the standard way: nss stays `files dns`,
# and /etc/resolv.conf points at resolved's stub (127.0.0.53), so glibc — and
# ssh's ProxyJump to the bare `runtime` — resolves *.mpd.test via resolved →
# the VM's dnsmasq, and everything else via the upstream resolved learned. The
# Apple-container catch: the runtime rewrites /etc/resolv.conf to the raw vmnet
# nameserver on every boot, clobbering that symlink. So mpd-resolv-stub.service
# (below) re-points it each boot — but only once mpd-virt's seedResolver has
# recorded the upstream (its 00-upstream.conf drop-in), since before that the
# raw file is the only working DNS and seedResolver reads it to find the
# upstream. That guard is what keeps the unit from clobbering resolv.conf too
# early and sending resolved into a forward-to-itself loop.
#
# The image is generic: the dev user + passwordless sudo + authorized key are
# provisioned AFTER start with `container exec` (see README), so one image
# serves every box and keys can be rotated without a rebuild.
#
# libpam-systemd + dbus-user-session are NOT decoration: a real Debian gets
# them via systemd's Recommends, but --no-install-recommends drops them, and
# without pam_systemd the per-user manager (user@<uid>) never gets a session or
# XDG_RUNTIME_DIR and fails — so mpd's user services (the portal `mpd --web`,
# `mpd --control`) never start and the box's root URL 502s. Installing them
# makes this image behave like the stock-Debian VMs adopt targets are. (The
# base is non-slim debian:trixie, matching mpd's "basic Trixie install"
# contract — an OCI base ships no systemd regardless, so the session stack is
# still installed explicitly below.)
#
#   container build -t mpd-virt-container-apple container
#   container run -d --name mpd-128 --cap-add ALL mpd-virt-container-apple
#   container exec mpd-128 systemctl is-system-running   # running/degraded = systemd up
FROM debian:trixie

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv systemd-resolved libpam-systemd \
        dbus dbus-user-session \
        openssh-server sudo wget git ca-certificates iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl enable ssh systemd-resolved \
    && systemctl mask systemd-modules-load.service

# sshd: key-only, a systemd unit now. Host keys are generated by the unit on
# first start. The dev user + key are added after boot via `container exec`.
RUN set -eux; \
    mkdir -p /run/sshd; \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'UseDNS no' \
      > /etc/ssh/sshd_config.d/10-hardening.conf

# Re-point /etc/resolv.conf at resolved's stub on every boot (see the DNS note
# at the top): the Apple runtime rewrites it to the raw vmnet nameserver each
# boot, which bypasses resolved. Guarded on the 00-upstream.conf drop-in so it
# never fires before mpd-virt's seedResolver has recorded the upstream — before
# that the raw file is the only working DNS, and seedResolver reads it to find
# the upstream. After= resolved so the stub file exists when we link to it.
RUN set -eux; \
    printf '%s\n' \
      '[Unit]' \
      'Description=Re-point /etc/resolv.conf at the systemd-resolved stub (Apple container rewrites it each boot)' \
      'After=systemd-resolved.service' \
      'Wants=systemd-resolved.service' \
      'ConditionPathExists=/run/systemd/resolve/stub-resolv.conf' \
      'ConditionPathExists=/etc/systemd/resolved.conf.d/00-upstream.conf' \
      '' \
      '[Service]' \
      'Type=oneshot' \
      'RemainAfterExit=yes' \
      'ExecStart=/bin/ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf' \
      '' \
      '[Install]' \
      'WantedBy=multi-user.target' \
      > /etc/systemd/system/mpd-resolv-stub.service; \
    systemctl enable mpd-resolv-stub.service

# systemd as PID 1. SIGRTMIN+3 is systemd's clean-shutdown signal.
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]

# Takeover-test container: a Debian Trixie box that boots systemd as PID 1
# under plain `container run`. Needs `--cap-add ALL` (systemd needs SYS_ADMIN
# to mount cgroups; without it, it exits silently). Hostname comes from --name.
#
# The image is generic: the dev user + passwordless sudo + authorized key are
# provisioned AFTER start with `container exec` (see README), so one image
# serves every box and keys can be rotated without a rebuild.
#
#   container build -t takeovertest containers/takeovertest
#   container run -d --name mpd-128 --cap-add ALL takeovertest
#   container exec mpd-128 systemctl is-system-running   # running/degraded = systemd up
FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        systemd systemd-sysv systemd-resolved dbus \
        openssh-server sudo wget git ca-certificates iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/* \
    && systemctl enable ssh systemd-resolved \
    && systemctl mask systemd-modules-load.service

# sshd: key-only, a systemd unit now. Host keys are generated by the unit on
# first start. The dev user + key are added after boot via `container exec`.
RUN set -eux; \
    mkdir -p /run/sshd; \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'UseDNS no' \
      > /etc/ssh/sshd_config.d/10-hardening.conf

# systemd as PID 1. SIGRTMIN+3 is systemd's clean-shutdown signal.
STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/sbin/init"]

# Takeover-test container: a fake freshly-provisioned mpd VM for `mpd-virt
# takeover` to adopt. Plain `container run` (vminitd), no systemd. Hostname
# comes from --name (`--name mpd-<NNN>` -> hostname mpd-<NNN>); the IP is
# whatever vmnet assigns (a guest-set IP is never routed, so we don't try).
#
# The image is FULLY generic: it bakes only the base OS, openssh, sudo, a few
# tools, and a tiny entrypoint that runs sshd. The dev user, its passwordless
# sudo, and the authorized SSH key are all created AFTER the container starts,
# with `container exec` (which runs via the runtime, so it needs no SSH — the
# ordering just works). One image serves every box and every user, and adding
# or rotating a key — or even the account — is a runtime step, never a rebuild.
# `mpd create` drives those exec calls; for manual use see the README.
#
#   container build -t takeovertest containers/takeovertest
#   container run -d --name mpd-128 --cap-add ALL takeovertest   # ALL: for Podman
#   # then create the user + sudo + authorize a key with `container exec` (README)
FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server sudo wget git ca-certificates iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# sshd: key-only. Host keys are generated on first boot by the entrypoint.
# sshd needs no dev user to start; the account is added later via exec.
RUN set -eux; \
    mkdir -p /run/sshd; \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'UseDNS no' \
      > /etc/ssh/sshd_config.d/10-hardening.conf

COPY entrypoint.sh /usr/local/sbin/entrypoint.sh
RUN chmod 0755 /usr/local/sbin/entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]

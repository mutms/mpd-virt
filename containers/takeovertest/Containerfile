# Takeover-test container: a fake freshly-provisioned mpd VM for `mpd-virt
# setup` to adopt. Plain `container run` (vminitd), no systemd. Hostname comes
# from --name (`--name mpd-<NNN>` -> hostname mpd-<NNN>); the IP is whatever
# vmnet assigns (a guest-set IP is never routed, so we don't try). Generic
# image, no build args. Add --cap-add ALL when Podman must run inside.
#
#   container build -t takeovertest containers/takeovertest
#   container run -d --name mpd-128 --cap-add ALL takeovertest
#   container ls        # note the vmnet-assigned IP, then: ssh skodak@<ip>
FROM debian:trixie-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        openssh-server sudo wget git ca-certificates iproute2 iputils-ping \
    && rm -rf /var/lib/apt/lists/*

# Dev user: skodak, passwordless sudo, authorized key.
RUN set -eux; \
    useradd --create-home --shell /bin/bash skodak; \
    usermod -aG sudo skodak; \
    echo 'skodak ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/90-skodak; \
    chmod 0440 /etc/sudoers.d/90-skodak; \
    install -d -m 0700 -o skodak -g skodak /home/skodak/.ssh
COPY authorized_keys /tmp/authorized_keys
RUN set -eux; \
    install -m 0600 -o skodak -g skodak /tmp/authorized_keys /home/skodak/.ssh/authorized_keys; \
    rm -f /tmp/authorized_keys

# sshd: key-only. Host keys generated on first boot by the entrypoint.
RUN set -eux; \
    mkdir -p /run/sshd; \
    printf '%s\n' \
      'PasswordAuthentication no' \
      'KbdInteractiveAuthentication no' \
      'PubkeyAuthentication yes' \
      'PermitRootLogin no' \
      'UseDNS no' \
      > /etc/ssh/sshd_config.d/10-hardening.conf

COPY entrypoint.sh /usr/local/sbin/entrypoint.sh
RUN chmod 0755 /usr/local/sbin/entrypoint.sh

EXPOSE 22
ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]
